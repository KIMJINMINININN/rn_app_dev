{
  "name": "@the-others/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:dev": "EXPO_PUBLIC_APP_ENV=develop expo start",
    "start:beta": "EXPO_PUBLIC_APP_ENV=beta expo start",
    "start:prod": "EXPO_PUBLIC_APP_ENV=production expo start",
    "android": "expo run:android",
    "android:dev": "EXPO_PUBLIC_APP_ENV=develop expo run:android",
    "android:beta": "EXPO_PUBLIC_APP_ENV=beta expo run:android",
    "android:prod": "EXPO_PUBLIC_APP_ENV=production expo run:android",
    "ios": "expo run:ios",
    "ios:dev": "EXPO_PUBLIC_APP_ENV=develop expo run:ios",
    "ios:beta": "EXPO_PUBLIC_APP_ENV=beta expo run:ios",
    "ios:prod": "EXPO_PUBLIC_APP_ENV=production expo run:ios",
    "web": "expo start --web",
    "reset-project": "node ./scripts/reset-project.js",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@the-others/webview-protocol": "workspace:*",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "^54.0.33",
    "expo-application": "^55.0.14",
    "expo-constants": "~18.0.13",
    "expo-device": "^55.0.15",
    "expo-font": "^14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "^6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "jail-monkey": "^2.8.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-play-integrity": "^1.1.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
