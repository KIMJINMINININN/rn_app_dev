{
  "name": "@the-others/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:push": "supabase db push --linked",
    "db:types": "supabase gen types typescript --linked > src/shared/api/supabase/types.ts",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:check-drift": "node scripts/check-migration-drift.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.1",
    "@tanstack/react-query": "^5.100.1",
    "@the-others/webview-protocol": "workspace:*",
    "axios": "1.15.2",
    "class-variance-authority": "^0.7.1",
    "dayjs": "^1.11.20",
    "dompurify": "^3.4.1",
    "js-cookie": "^3.0.5",
    "jwt-decode": "^4.0.0",
    "lodash-es": "4.18.1",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-calendar": "^6.0.1",
    "react-clock": "^6.0.0",
    "react-datetime-picker": "^7.0.2",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "zod": "^4.4.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.100.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jsdom": "^29.1.0",
    "npm-check-updates": "^21.0.3",
    "supabase": "^2.95.6",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
